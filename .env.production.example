POSTGRES_DB="sistema_lealtad"
POSTGRES_USER="lealtad"
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_LOCAL_VALUE

MINIO_ACCESS_KEY=REPLACE_WITH_SECURE_LOCAL_VALUE
MINIO_SECRET_KEY="replace-with-a-long-random-storage-password"
MINIO_BUCKET="lealtad-media"

JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_LOCAL_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_SECURE_LOCAL_VALUE
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="30"

ADMIN_DOMAIN="admin.example.com"
CLIENT_DOMAIN="app.example.com"
API_DOMAIN="api.example.com"

HTTP_PORT="80"
HTTPS_PORT="443"
S3_REGION="us-east-1"
PRODUCTION_BACKUP_PATH="./backups-production"
BACKUP_INTERVAL_SECONDS="86400"
BACKUP_RETENTION_DAYS="30"
