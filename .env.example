DATABASE_URL=REPLACE_WITH_SECURE_LOCAL_VALUE
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_LOCAL_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_SECURE_LOCAL_VALUE
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="30"
SEED_SUPER_ADMIN_EMAIL="admin@example.com"
SEED_SUPER_ADMIN_PASSWORD=REPLACE_WITH_SECURE_LOCAL_VALUE
SEED_SUPER_ADMIN_FULL_NAME="Super Administrador"
APP_ENV="development"
# Pon en "true" solo cuando el trafico llegue al API por HTTPS real (TLS termination
# propio o detras de un proxy/balanceador con HTTPS). Si esto es "true" sin HTTPS real,
# los navegadores descartan las cookies de sesion y nadie puede iniciar sesion.
COOKIE_SECURE="false"
API_PORT="4000"
ADMIN_WEB_URL="http://localhost:3000"
CLIENT_PWA_URL="http://localhost:3002"
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Opcional: activa Google Maps Embed en la vista previa de direcciones.
# Restringe esta key por dominio/referrer en Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"
MEDIA_STORAGE_DIR="$HOME/sistema-lealtad-media"
MEDIA_STORAGE_PROVIDER="LOCAL"

# Storage S3 compatible (AWS S3, Cloudflare R2, MinIO, etc.).
# Para usarlo cambia MEDIA_STORAGE_PROVIDER a "S3".
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="lealtad-media"
S3_ACCESS_KEY_ID="lealtad-local"
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECURE_LOCAL_VALUE
S3_FORCE_PATH_STYLE="true"

# Backups locales. En produccion, monta /backups en almacenamiento externo.
BACKUP_INTERVAL_SECONDS="86400"
BACKUP_RETENTION_DAYS="14"

# Ejemplo produccion:
# ADMIN_WEB_URL="https://admin.tudominio.com"
# CLIENT_PWA_URL="https://app.tudominio.com"
# API_URL="https://api.tudominio.com"
# NEXT_PUBLIC_API_URL="https://api.tudominio.com/api"
# CORS_ORIGINS="https://admin.tudominio.com,https://app.tudominio.com"
